      *> POLYCALL-CONSTANTS -- Polycall binding ABI v1 status codes and
      *> limits (<polycall.h>, polycall >= 1.1.0). Valid in fixed and
      *> free source format.
       78  PC-ABI-VERSION              VALUE 1.
       78  PC-OK                       VALUE 0.
       78  PC-E-INVALID-ARGUMENT       VALUE -1.
       78  PC-E-NO-MEMORY              VALUE -2.
       78  PC-E-INVALID-HANDLE         VALUE -3.
       78  PC-E-TIMEOUT                VALUE -4.
       78  PC-E-TRANSPORT              VALUE -5.
       78  PC-E-PROTOCOL               VALUE -6.
       78  PC-E-NOT-FOUND              VALUE -7.
       78  PC-E-AUTH                   VALUE -8.
       78  PC-E-REMOTE                 VALUE -9.
       78  PC-E-TOO-LARGE              VALUE -10.
       78  PC-E-BUSY                   VALUE -11.
       78  PC-E-CANCELLED              VALUE -12.
       78  PC-E-CONFIG                 VALUE -13.
       78  PC-E-ADDRESS-IN-USE         VALUE -14.
       78  PC-E-UNSUPPORTED            VALUE -15.
       78  PC-E-PERMISSION             VALUE -16.
       78  PC-E-CLOSED                 VALUE -17.
       78  PC-E-INTERNAL               VALUE -18.
      *> limits
       78  PC-MAX-PAYLOAD              VALUE 1048576.
       78  PC-WAIT-FOREVER             VALUE -1.
